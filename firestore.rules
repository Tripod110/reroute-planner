rules_version = '2';

// Single-user app: every doc lives under users/{uid}, and a user can only
// read/write their own subtree. Paste this into Firebase console ->
// Firestore Database -> Rules, or deploy via `firebase deploy --only
// firestore:rules` if the Firebase CLI is set up.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
