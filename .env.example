# Copy this file to .env and fill in real values. .env is gitignored —
# never commit your Canvas token.

# Your school's Canvas domain, no https:// and no trailing slash.
CANVAS_DOMAIN=canvas.rowan.edu

# Generate at: https://<CANVAS_DOMAIN>/profile/settings -> "+ New Access Token"
CANVAS_TOKEN=

# Port for the local proxy server (server/index.js)
SERVER_PORT=3001

# Firebase web config — from Firebase console -> Project settings ->
# General -> Your apps -> Web app -> SDK setup and configuration.
# Not a secret (access is locked down by firestore.rules, not by hiding
# this), but VITE_ prefix is required for Vite to expose it to the client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key — from https://aistudio.google.com/apikey. Server-side
# only (server/geminiClient.js); never exposed to the client bundle.
GEMINI_API_KEY=
# Optional override; defaults to the cheapest current tier.
GEMINI_MODEL=gemini-3.5-flash-lite
